# Public URL of the deployed app (local development defaults to localhost).
# For Wi-Fi testing, use the computer's LAN IP (for example, http://192.168.1.10:3000).
APP_URL=http://localhost:3000
VITE_ANDROID_API_URL=http://192.168.1.10:3000/api

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/fixmate

# Generate a unique random value for each deployment.
JWT_SECRET=

# Admin account bootstrap. ADMIN_PASSWORD must be at least 7 characters.
ADMIN_EMAIL= 
ADMIN_PASSWORD=
ADMIN_NAME=FixMate Administrator

# Gmail SMTP account verification (use a Google App Password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional: set only when Gemini-powered features are enabled.
GEMINI_API_KEY=
